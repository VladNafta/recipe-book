{
  "info": {
    "name": "Recipes API",
    "description": "Тестування REST API записника рецептів (ЛР3)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Список рецептів",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/recipes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recipes"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Відповідь — масив рецептів\", () => {",
              "  const data = pm.response.json();",
              "  pm.expect(data).to.be.an(\"array\");",
              "  pm.expect(data.length).to.be.at.least(8);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Фільтр за категорією",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/recipes?category=Салати",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recipes"
          ],
          "query": [
            {
              "key": "category",
              "value": "Салати"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Усі рецепти з категорії «Салати»\", () => {",
              "  pm.response.json().forEach(r => pm.expect(r.category).to.eql(\"Салати\"));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Створити рецепт",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recipes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recipes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Млинці\",\n  \"category\": \"Десерти\",\n  \"cook_time\": 30,\n  \"servings\": 4,\n  \"ingredients\": [\n    \"молоко\",\n    \"яйця\",\n    \"борошно\",\n    \"цукор\"\n  ],\n  \"steps\": \"Змішати інгредієнти й смажити млинці на сковороді.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 201 Created\", () => pm.response.to.have.status(201));",
              "pm.test(\"Рецепт отримав id\", () => {",
              "  const r = pm.response.json();",
              "  pm.expect(r.id).to.be.a(\"number\");",
              "  pm.expect(r.title).to.eql(\"Млинці\");",
              "  pm.collectionVariables.set(\"recipeId\", r.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Отримати рецепт за id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/recipes/{{recipeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recipes",
            "{{recipeId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Це створений рецепт\", () => {",
              "  pm.expect(pm.response.json().title).to.eql(\"Млинці\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Оновити рецепт",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recipes/{{recipeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recipes",
            "{{recipeId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Млинці з сиром\",\n  \"category\": \"Десерти\",\n  \"cook_time\": 35,\n  \"servings\": 4,\n  \"ingredients\": [\n    \"молоко\",\n    \"яйця\",\n    \"борошно\",\n    \"цукор\",\n    \"кисломолочний сир\"\n  ],\n  \"steps\": \"Змішати інгредієнти й смажити млинці на сковороді.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Дані оновлено\", () => {",
              "  const r = pm.response.json();",
              "  pm.expect(r.title).to.eql(\"Млинці з сиром\");",
              "  pm.expect(r.cook_time).to.eql(35);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Видалити рецепт",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/recipes/{{recipeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recipes",
            "{{recipeId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 204 No Content\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Рецепт після видалення",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/recipes/{{recipeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recipes",
            "{{recipeId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Повідомлення про помилку\", () => {",
              "  pm.expect(pm.response.json().error).to.eql(\"Рецепт не знайдено\");",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "recipeId",
      "value": ""
    }
  ]
}